# =============================================================================
#  基于 RAG 的金融制度类知识问答系统 · Git 忽略规则
# =============================================================================

# ---- 密钥与本地配置（最重要：绝不能提交） ----
.env
.env.local
.env.*.local
deploy/.env
backend/.env
frontend/.env.local
*.pem
*.key

# ---- 运行时数据与卷（体积大、且含真实制度原文） ----
# data/ 下只有「知识点候选」与「文档登记」两份交付物入库，
# 其余（上传原件、OCR 缓存、模型权重、评测集）一律忽略。
data/*
!data/knowledge_points/
!data/metadata/
data/knowledge_points/*
!data/knowledge_points/knowledge_points_candidates.xlsx
data/metadata/*
!data/metadata/document_registry.xlsx
deploy/data/
volumes/
deploy/volumes/
backups/
reports/
logs/
*.log

# ---- 测试与评测产物 ----
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
data/eval/*.xlsx

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
backend/jieba.cache
backend/pip-unpack-*/
backend/uv-install.log
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.conda/

# ---- Node / 前端 ----
node_modules/
frontend/dist/
frontend/.vite/
.pnpm-store/
*.tsbuildinfo

# ---- IDE 与操作系统 ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- 临时文件 ----
*.tmp
*.bak
*~
