# =============================================================================
#  基于 RAG 的金融制度类知识问答系统 · 环境变量模板
#
#  用法：cp .env.example .env  然后按下方【必须修改】项填写。
#  说明：本文件被 docker compose 用于变量替换，同时通过 env_file 注入 backend 容器；
#        本地直跑后端时，复制到 backend/.env 即可。
#  安全：.env 已被 .gitignore 忽略，切勿提交真实密钥。
# =============================================================================

# -----------------------------------------------------------------------------
# 0. 通用
# -----------------------------------------------------------------------------
TZ=Asia/Shanghai
APP_ENV=production                 # production / development
APP_VERSION=1.0.0
APP_NAME=finrag
LOG_LEVEL=INFO                     # DEBUG / INFO / WARNING / ERROR
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# 【必须修改】JWT 签名密钥。生成方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_please_generate_a_random_32_byte_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=480    # 8 小时
JWT_ALGORITHM=HS256

# 种子管理员（后端启动时创建或校正；首次登录后请立即改密）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_REAL_NAME=系统管理员
EDITOR_INVITE_CODE=FINRAG2025      # 注册时携带正确邀请码则授予 editor 角色

# -----------------------------------------------------------------------------
# 1. 宿主机端口映射（仅 docker compose 使用）
# -----------------------------------------------------------------------------
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=8000
MYSQL_HOST_PORT=3306
MILVUS_HOST_PORT=19530
MILVUS_METRICS_HOST_PORT=9091
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
ATTU_HOST_PORT=3000

# -----------------------------------------------------------------------------
# 2. MySQL
# -----------------------------------------------------------------------------
# 【必须修改】数据库密码
MYSQL_ROOT_PASSWORD=finrag_root_2025
MYSQL_DATABASE=finrag
MYSQL_USER=finrag
MYSQL_PASSWORD=finrag_pass_2025
# 容器内地址（本地直跑后端时改为 127.0.0.1）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_CHARSET=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false                      # true 打印 SQL，仅开发期

# -----------------------------------------------------------------------------
# 3. Milvus
# -----------------------------------------------------------------------------
MILVUS_VERSION=v2.4.9
MILVUS_HOST=milvus                 # 本地直跑后端时改为 127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=finrag_embedding_v1
MILVUS_ALIAS=finrag_embedding      # 代码只使用别名，便于零停机重建索引
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_SEARCH_EF=64
MILVUS_TIMEOUT=10

# MinIO（Milvus 内部对象存储，一般无需修改）
# 官方 minio/minio 镜像已从 Docker Hub 下线，默认改用 Bitnami 打包的同一镜像
MINIO_IMAGE=bitnamilegacy/minio:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
ATTU_VERSION=v2.4

# -----------------------------------------------------------------------------
# 4. 大模型（OpenAI 兼容协议）
#    切换厂商只需改这三项，不改代码。参见 docs/00 ADR-03。
# -----------------------------------------------------------------------------
# 【必须修改】填入可用的 API Key
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-CHANGE_ME
LLM_MODEL=deepseek-chat

# 备用渠道（主渠道失败或超时自动降级）
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_API_KEY=sk-CHANGE_ME
LLM_FALLBACK_MODEL=qwen-plus

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
LLM_TIMEOUT=20                     # 单次请求超时（秒）
LLM_TTFT_TIMEOUT=5                 # 首 token 超时（秒），超时不判失败，仅提示
LLM_DAILY_TOKEN_BUDGET=2000000     # 当日 token 预算，超限降级为"仅检索模式"
LLM_MAX_CONCURRENCY=5

# -----------------------------------------------------------------------------
# 5. 向量化模型
#    local  ：本地 sentence-transformers 推理，无调用费用，首次启动下载权重
#    cloud  ：走 OpenAI 兼容的 embedding 接口
#    参见 docs/00 ADR-02
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu               # cpu / cuda / mps
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=512
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE_DIR=/data/models   # 挂载卷，避免容器重建后重复下载
# 离线部署时把权重预先放入该目录，并把 HF_HUB_OFFLINE 设为 1
HF_ENDPOINT=https://hf-mirror.com  # 国内网络加速
HF_HUB_OFFLINE=0

# -----------------------------------------------------------------------------
# 6. 重排模型（一期关闭，二期开启）
# -----------------------------------------------------------------------------
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MIN_SCORE=0.35
RERANK_TOP_N=5

# -----------------------------------------------------------------------------
# 7. 检索参数（详见 docs/05）
# -----------------------------------------------------------------------------
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
FINAL_TOP_N=5
RRF_K=60
RRF_W_VECTOR=0.6
RRF_W_KEYWORD=0.4
RRF_REF=0.03
RETRIEVAL_MIN_SCORE=0.30

TIMELINESS_WEIGHT_EFFECTIVE=1.00
TIMELINESS_WEIGHT_AMENDED=0.90
TIMELINESS_WEIGHT_UNKNOWN=0.80
TIMELINESS_WEIGHT_REPEALED=0.50

# -----------------------------------------------------------------------------
# 8. Prompt 与多轮
# -----------------------------------------------------------------------------
PROMPT_VERSION=v1.2
MAX_CONTEXT_CHARS=4000
MULTI_TURN_ENABLED=true
MULTI_TURN_HISTORY_SIZE=3
QUERY_REWRITE_TIMEOUT_MS=800

# -----------------------------------------------------------------------------
# 9. 文档解析与 OCR（详见 docs/04）
# -----------------------------------------------------------------------------
DATA_DIR=/data
UPLOAD_DIR=/data/uploads
OCR_CACHE_DIR=/data/ocr_cache
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.txt,.md,.png,.jpg,.jpeg,.tiff

PDF_TEXT_MIN_CHARS=20
PDF_TEXT_MIN_CHARS_PER_PAGE=50

OCR_LANG=chi_sim+eng
OCR_DPI=300
OCR_PSM=6
OCR_OEM=1
OCR_MAX_WORKERS=4
OCR_MIN_CONFIDENCE=60
OCR_PAGE_TIMEOUT=30

CHUNK_SIZE=500
CHUNK_OVERLAP=80
CHUNK_MAX=800
CHUNK_MIN_MERGE=120

WITH_LIBREOFFICE=false             # true 时 Dockerfile 安装 LibreOffice 以支持 .doc

# -----------------------------------------------------------------------------
# 10. 限流与安全
# -----------------------------------------------------------------------------
RATE_LIMIT_QA_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120
PASSWORD_BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# 11. 前端构建参数（Vite 在构建期读取，运行时不可更改）
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=金融制度知识问答系统
VITE_UPLOAD_MAX_MB=50
