# =============================================================================
#  本地直跑后端时的环境变量模板（Docker 部署请用 deploy/.env.example）
#  用法：cp .env.example .env   然后至少填 LLM_API_KEY
#  说明：与 deploy/.env.example 同名同义，差异仅在主机地址（本地直连 127.0.0.1）
# =============================================================================

APP_ENV=development
APP_VERSION=1.0.0
APP_NAME=finrag
LOG_LEVEL=DEBUG
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# 【必须修改】JWT 签名密钥：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_please_generate_a_random_32_byte_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_ALGORITHM=HS256

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_REAL_NAME=系统管理员
EDITOR_INVITE_CODE=FINRAG2025

# --- MySQL（docker-compose.infra.yml 默认端口） ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finrag
MYSQL_USER=finrag
MYSQL_PASSWORD=finrag_pass_2025
MYSQL_ROOT_PASSWORD=finrag_root_2025
MYSQL_CHARSET=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Milvus ---
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=finrag_embedding_v1
MILVUS_ALIAS=finrag_embedding
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_SEARCH_EF=64
MILVUS_TIMEOUT=10

# --- 大模型（OpenAI 兼容协议，切换厂商只改三项，ADR-03） ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
# 【必须修改】
LLM_API_KEY=sk-CHANGE_ME
LLM_MODEL=deepseek-chat
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_API_KEY=sk-CHANGE_ME
LLM_FALLBACK_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
LLM_TIMEOUT=20
LLM_TTFT_TIMEOUT=5
LLM_DAILY_TOKEN_BUDGET=2000000
LLM_MAX_CONCURRENCY=5

# --- 向量化（local / cloud / fake；测试可设 fake 免下载权重） ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=512
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE_DIR=./data/models
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=0

# --- 重排（一期关闭，ADR-05） ---
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MIN_SCORE=0.35
RERANK_TOP_N=5

# --- 检索参数（docs/05 §14） ---
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
FINAL_TOP_N=5
RRF_K=60
RRF_W_VECTOR=0.6
RRF_W_KEYWORD=0.4
RRF_REF=0.03
RETRIEVAL_MIN_SCORE=0.30
TIMELINESS_WEIGHT_EFFECTIVE=1.00
TIMELINESS_WEIGHT_AMENDED=0.90
TIMELINESS_WEIGHT_UNKNOWN=0.80
TIMELINESS_WEIGHT_REPEALED=0.50

# --- Prompt 与多轮 ---
PROMPT_VERSION=v1.2
MAX_CONTEXT_CHARS=4000
MULTI_TURN_ENABLED=true
MULTI_TURN_HISTORY_SIZE=3
QUERY_REWRITE_TIMEOUT_MS=800
QUERY_VECTOR_CACHE_SIZE=500

# --- 文档解析与 OCR（docs/04 §9） ---
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
OCR_CACHE_DIR=./data/ocr_cache
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.txt,.md,.png,.jpg,.jpeg,.tiff
PDF_TEXT_MIN_CHARS=20
PDF_TEXT_MIN_CHARS_PER_PAGE=50
OCR_LANG=chi_sim+eng
OCR_DPI=300
OCR_PSM=6
OCR_OEM=1
OCR_MAX_WORKERS=4
OCR_MIN_CONFIDENCE=60
OCR_PAGE_TIMEOUT=30
CHUNK_SIZE=500
CHUNK_OVERLAP=80
CHUNK_MAX=800
CHUNK_MIN_MERGE=120

# --- 限流与安全 ---
RATE_LIMIT_QA_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120
PASSWORD_BCRYPT_ROUNDS=12
# Optional vector-only evidence gate. Keep disabled until evaluated with
# labeled questions for the selected embedding model and corpus.
QA_MIN_VECTOR_SIMILARITY=0.0
